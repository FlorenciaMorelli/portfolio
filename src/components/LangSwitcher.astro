---
import { localizedPath, otherLocale, useTranslations, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
  href?: string;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const target = otherLocale(locale);
const href = Astro.props.href ?? localizedPath(target, '');
---

<a class="lang-switch" href={href} hreflang={target} aria-label={t.lang.switchTo} data-lang-switch>
  <span class:list={['lang-switch__code', locale === 'es' && 'is-current']} aria-hidden="true">ES</span>
  <span class="lang-switch__sep" aria-hidden="true">/</span>
  <span class:list={['lang-switch__code', locale === 'en' && 'is-current']} aria-hidden="true">EN</span>
</a>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: 2.25rem;
    padding-inline: var(--space-2);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    line-height: var(--text-mono-lh);
    color: var(--text-faint);
    transition: background var(--dur-fast) var(--ease);
  }
  .lang-switch:hover {
    background: var(--surface-alt);
    color: var(--text-faint);
  }
  .lang-switch__code.is-current {
    color: var(--text);
  }
</style>

<script>
  // Keep the current section when switching language.
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((link) => {
    const base = link.getAttribute('href') ?? '';
    const sync = () => link.setAttribute('href', base + location.hash);
    sync();
    window.addEventListener('hashchange', sync);
  });
</script>
