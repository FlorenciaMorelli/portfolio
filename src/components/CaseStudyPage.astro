---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Icon from './Icon.astro';
import { useTranslations, localizedPath, otherLocale, type Locale } from '../i18n/utils';
import { getCaseStudy, caseStudyPath } from '../lib/case-studies';
import { assetUrl } from '../lib/url';

interface Props {
  locale: Locale;
  slug: string;
}
const { locale, slug } = Astro.props;
const t = useTranslations(locale);
const study = getCaseStudy(slug);
if (!study) throw new Error(`Unknown case study: ${slug}`);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const strip = (path: string) => path.slice(base.length);
const projectsHref = `${localizedPath(locale, '')}/#projects`;
const { cover } = study;
const studioName = study.studio?.name;
---

<BaseLayout
  locale={locale}
  title={`${study.name} · ${t.caseStudy.eyebrow} · Florencia Morelli`}
  description={study.summary[locale]}
  alternates={{ es: strip(caseStudyPath('es', slug)), en: strip(caseStudyPath('en', slug)) }}
>
  <span id="top"></span>
  <Header locale={locale} onHome={false} altHref={caseStudyPath(otherLocale(locale), slug)} />
  <main id="main" class="case">
    <section class="case__hero">
      <div class="container">
        <nav class="crumbs" aria-label={t.caseStudy.breadcrumb}>
          <ol>
            <li><a href={projectsHref}>{t.nav.projects}</a></li>
            <li aria-current="page">{study.name}</li>
          </ol>
        </nav>

        <p class="case__meta">
          <span class="tag">{t.projects.client}</span>
          {studioName && <span>{t.projects.builtAt.replace('{studio}', studioName)}</span>}
        </p>
        <h1 class="case__title">{study.name}</h1>
        <p class="case__summary">{study.summary[locale]}</p>

        <div class="case__actions">
          {study.website && (
            <a class="btn btn--primary" href={study.website} target="_blank" rel="noopener">
              {t.caseStudy.visit}<Icon name="external" size={18} />
            </a>
          )}
          {study.studio && (
            <a class="btn btn--secondary" href={study.studio.url} target="_blank" rel="noopener">
              {t.caseStudy.studio}
            </a>
          )}
        </div>

        <dl class="case__facts">
          {study.facts.map((fact) => (
            <div>
              <dt>{fact.label[locale]}</dt>
              <dd>{fact.value[locale]}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <div class="container">
      <figure class="pair">
        <img
          class="pair__desktop"
          src={assetUrl(cover.desktop.src)}
          alt={cover.desktop.alt[locale]}
          width={cover.desktop.width}
          height={cover.desktop.height}
          fetchpriority="high"
        />
        <img
          class="pair__mobile"
          src={assetUrl(cover.mobile.src)}
          alt={cover.mobile.alt[locale]}
          width={cover.mobile.width}
          height={cover.mobile.height}
        />
      </figure>

      <section class="stats" aria-labelledby="highlights-title">
        <h2 id="highlights-title" class="visually-hidden">{t.caseStudy.highlights}</h2>
        <ul>
          {study.highlights.map((item) => (
            <li>
              <strong>{item.value[locale]}</strong>
              <span>{item.label[locale]}</span>
            </li>
          ))}
        </ul>
      </section>
    </div>

    {study.sections.map((section) =>
      section.gallery || section.cards ? (
        <section id={section.id} class="part part--wide reveal">
          <div class="container">
            <div class="part__head">
              <h2 class="part__title">{section.title[locale]}</h2>
              {section.note && <p class="part__note">{section.note[locale]}</p>}
            </div>

            {section.cards && (
              <ol class="decisions">
                {section.cards.map((card, i) => (
                  <li class="decision">
                    <span class="decision__num">{String(i + 1).padStart(2, '0')}</span>
                    <h3>{card.title[locale]}</h3>
                    <p>{card.body[locale]}</p>
                  </li>
                ))}
              </ol>
            )}

            {section.gallery && (
              <div class="gallery">
                {section.gallery.map((shot) => (
                  <figure>
                    <div class="pair">
                      <img
                        class="pair__desktop"
                        src={assetUrl(shot.desktop.src)}
                        alt={shot.desktop.alt[locale]}
                        width={shot.desktop.width}
                        height={shot.desktop.height}
                        loading="lazy"
                        decoding="async"
                      />
                      <img
                        class="pair__mobile"
                        src={assetUrl(shot.mobile.src)}
                        alt={shot.mobile.alt[locale]}
                        width={shot.mobile.width}
                        height={shot.mobile.height}
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                    <figcaption>{shot.caption[locale]}</figcaption>
                  </figure>
                ))}
              </div>
            )}
          </div>
        </section>
      ) : (
        <section id={section.id} class="part reveal">
          <div class="container part__block">
            <h2 class="part__title part__title--small">{section.title[locale]}</h2>
            <div class="part__content">
              {section.tags && (
                <ul class="chips">
                  {section.tags.map((tag) => <li class="tag tag--tech">{tag}</li>)}
                </ul>
              )}

              {section.body && (
                <div class="prose">
                  {section.body[locale].map((paragraph) => <p>{paragraph}</p>)}
                </div>
              )}

              {section.list && (
                <ul class="checks">
                  {section.list[locale].map((item) => (
                    <li>
                      <Icon name="check" size={18} />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        </section>
      ),
    )}

    <div class="container case__end">
      <a class="btn btn--secondary" href={projectsHref}>{t.caseStudy.more}</a>
    </div>
  </main>
  <Footer locale={locale} />
</BaseLayout>

<style>
  .case__hero {
    padding-block: calc(var(--header-h) + var(--space-16)) var(--space-12);
  }

  /* Breadcrumb: Projects / name, replacing the old eyebrow and back link */
  .crumbs ol {
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-muted);
  }
  .crumbs a {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .crumbs li + li::before {
    content: '/';
    content: '/' / '';
    margin-right: var(--space-2);
    color: var(--text-faint);
  }

  .case__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
    color: var(--text-muted);
  }
  .case__title {
    margin-top: var(--space-4);
  }
  .case__summary {
    max-width: 48rem;
    margin-top: var(--space-6);
    font-size: var(--text-lead);
    line-height: var(--text-lead-lh);
    color: var(--text-muted);
  }
  .case__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  /* Fact sheet (Ficha) */
  .case__facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4) var(--space-6);
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: var(--border-width) solid var(--border);
  }
  .case__facts dt {
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    line-height: var(--text-mono-lh);
    color: var(--text-faint);
  }
  .case__facts dd {
    margin: var(--space-2) 0 0;
    line-height: var(--text-base-lh);
  }

  /* Screenshot pair: both images end up the same height */
  .pair {
    display: grid;
    grid-template-columns: 3.46fr 1fr;
    gap: var(--space-4);
    align-items: start;
    max-width: 62.5rem;
  }
  .pair img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-2);
  }

  /* Key figures: one card each */
  .stats ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: center;
    gap: var(--space-6);
    margin-top: var(--space-12);
  }
  .stats li {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-6);
    background: var(--surface);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-xl);
  }
  .stats strong {
    font-size: var(--text-stat);
    line-height: var(--text-stat-lh);
    letter-spacing: var(--text-stat-ls);
    font-weight: 600;
    color: var(--accent);
  }
  .stats span {
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
    color: var(--text-muted);
  }

  /* Parts of the write-up: title on the left, content on the right, a line between them */
  .part {
    padding-block: calc(var(--space-16) + var(--space-2));
    border-top: var(--border-width) solid var(--border);
  }
  .case__hero + .container + .part,
  .stats + .part {
    margin-top: var(--space-20);
  }
  .part__block {
    display: grid;
    grid-template-columns: 11fr 19fr;
  }
  .part__title--small {
    font-size: var(--text-h3);
    line-height: var(--text-h3-lh);
    letter-spacing: var(--text-h3-ls);
  }
  .part__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .prose {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    font-size: var(--text-lead);
    line-height: var(--text-lead-lh);
    color: var(--text-muted);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .chips .tag--tech {
    background: var(--surface-alt);
  }
  /* Two columns that fill top to bottom, as in Figma */
  .checks {
    column-count: 2;
    column-gap: var(--space-10);
  }
  .checks li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
    break-inside: avoid;
    color: var(--text-muted);
  }
  .checks :global(svg) {
    margin-top: 0.25rem;
    color: var(--accent);
  }

  /* Wide parts (screens, decisions) have the big heading and an intro on the right */
  .part__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-3) var(--space-8);
  }
  .part__note {
    max-width: 35rem;
    font-size: var(--text-lead);
    line-height: var(--text-lead-lh);
    color: var(--text-muted);
  }
  .gallery {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    margin-top: var(--space-16);
  }
  .gallery figcaption {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
    color: var(--text-muted);
  }

  .decisions {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-16);
    padding: 0;
    list-style: none;
  }
  .decision {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    background: var(--surface);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-xl);
  }
  .decision__num {
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    line-height: var(--text-mono-lh);
    color: var(--accent);
  }
  .decision h3 {
    font-size: var(--text-h4);
    line-height: var(--text-h4-lh);
  }
  .decision p {
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
    color: var(--text-muted);
  }

  .case__end {
    padding-top: var(--space-3);
    padding-bottom: var(--space-4);
  }

  @media (max-width: 1023.98px) {
    .decisions {
      grid-template-columns: 1fr;
    }
    .part__block {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
  @media (max-width: 767.98px) {
    .case__hero {
      padding-top: calc(var(--header-h) + var(--space-10));
    }
    .case__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .pair {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
    .pair__mobile {
      max-width: 12.25rem;
    }
    .stats ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4);
    }
    .stats li {
      padding: var(--space-4);
    }
    .part {
      padding-block: var(--space-12);
    }
    .checks {
      column-count: 1;
    }
    .gallery {
      gap: var(--space-12);
    }
  }
</style>
