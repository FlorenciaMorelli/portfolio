---
// Quality lens: the files of the last unit test run with their ticks and durations, and an
// «n of n» summary, all from src/lib/test-stats.ts (written at the start of every build).
// Decorative (aria-hidden). Steps: each suite is ticked in turn.
import Icon from '../Icon.astro';
import { testStats } from '../../lib/test-stats';
import './lens.css';

const stats = testStats();
---

<div class="lens results" aria-hidden="true" style={`--steps: ${stats.files.length}`}>
  <p class="results__cmd">npm test</p>
  <ul class="results__files">
    {stats.files.map((file, i) => (
      <li>
        <span class="results__tick" data-step style={`--from: ${i}`}><Icon name="check" size={14} /></span>
        <span class="lens__ellipsis">{file.file}</span>
        <span class="results__ms">{file.ms} ms</span>
      </li>
    ))}
  </ul>
  <p class="results__sum" data-step style={`--from: ${stats.files.length - 1}`}>{stats.passed} / {stats.total}</p>
</div>

<style>
  .results {
    padding: var(--space-3) var(--space-4);
  }
  .results__cmd {
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    line-height: var(--text-mono-sm-lh);
    color: var(--text-faint);
  }
  .results__files {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    line-height: var(--text-mono-sm-lh);
    color: var(--text);
  }
  .results__files li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .results__tick {
    display: inline-flex;
    flex: none;
    color: var(--accent);
  }
  .results__ms {
    margin-left: auto;
    color: var(--text-faint);
  }
  .results__sum {
    margin-top: var(--space-2);
    padding-top: var(--space-2);
    border-top: var(--border-width) solid var(--border);
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    line-height: var(--text-mono-sm-lh);
    color: var(--text);
  }
</style>
