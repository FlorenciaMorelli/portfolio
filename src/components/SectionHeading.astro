---
interface Props {
  title: string;
  /** Short line on the right of the title (below it on small screens). */
  intro?: string;
}
const { title, intro } = Astro.props;
---

<div class="section-heading depth">
  <h2 class="section-heading__title">{title}</h2>
  {intro && <p class="section-heading__intro">{intro}</p>}
</div>

<style>
  .section-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-3) var(--space-8);
  }
  .section-heading__intro {
    max-width: 36rem;
    font-size: var(--text-lead);
    line-height: var(--text-lead-lh);
    color: var(--text-muted);
    text-align: right;
  }

  @media (max-width: 767.98px) {
    .section-heading {
      flex-direction: column;
      align-items: flex-start;
    }
    .section-heading__intro {
      text-align: left;
    }
  }
</style>
