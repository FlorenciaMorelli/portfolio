---
import Icon from './Icon.astro';
import { useTranslations, type Locale } from '../i18n/utils';
import { assetUrl } from '../lib/url';
import type { IconName } from '../lib/types';
import profile from '../data/profile.json';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const photo = assetUrl(profile.photo);

// The four facets share their name and color with the hero cursors.
type Facet = 'analysis' | 'design' | 'development' | 'quality';
const facets: { id: Facet; icon: IconName; name: string }[] = [
  { id: 'analysis', icon: 'clipboard-list', name: t.hero.modes.analysis },
  { id: 'design', icon: 'pen-tool', name: t.hero.modes.design },
  { id: 'development', icon: 'code-xml', name: t.hero.modes.development },
  { id: 'quality', icon: 'check-check', name: t.hero.modes.quality },
];
const [lead, ...rest] = t.about.body;
---

<section id="about" class="section about">
  <div class="container">
    <div class="about__intro">
      <h2 class="about__title">{t.about.title}</h2>
      <img
        class="about__photo"
        src={photo}
        alt={t.about.photoAlt}
        width="800"
        height="1000"
        loading="lazy"
        decoding="async"
      />
      <div class="about__text">
        <p class="about__lead">{lead}</p>
        {rest.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>

    <h3 class="about__subtitle">{t.about.howTitle}</h3>
    <ul class="facets">
      {facets.map((facet) => (
        <li class={`facet facet--${facet.id}`}>
          <span class="facet__icon" aria-hidden="true"><Icon name={facet.icon} size={20} /></span>
          <h4 class="facet__name">{facet.name}</h4>
          <p class="facet__desc">{t.about.how[facet.id]}</p>
        </li>
      ))}
    </ul>

    <h3 class="about__subtitle">{t.about.skillsTitle}</h3>
    <dl class="stack">
      {profile.skillGroups.map((group) => (
        <div class="stack__row">
          <dt>{t.about.skillsCategories[group.key] ?? group.key}</dt>
          <dd>
            <ul class="stack__items">
              {group.items.map((skill) => <li>{skill}</li>)}
            </ul>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .about {
    padding-block: var(--space-30);
  }

  /* Photo on the left, title and text on the right (title first on small screens) */
  .about__intro {
    display: grid;
    grid-template-areas:
      'title'
      'photo'
      'text';
    gap: var(--space-6);
  }
  .about__title {
    grid-area: title;
  }
  .about__photo {
    grid-area: photo;
    width: 100%;
    max-width: 25rem;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-xl);
  }
  .about__text {
    grid-area: text;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .about__text p {
    color: var(--text-muted);
  }
  .about__text .about__lead {
    font-size: var(--text-lead);
    line-height: var(--text-lead-lh);
    color: var(--text);
  }

  .about__subtitle {
    margin-top: var(--space-16);
    margin-bottom: var(--space-6);
  }

  /* How I work: one card per facet, colored like its hero cursor */
  .facets {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
  }
  .facet {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    background: var(--surface);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-xl);
  }
  .facet__icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-bottom: var(--space-1);
    border-radius: var(--radius-sm);
  }
  .facet__name {
    font-size: var(--text-h4);
    line-height: var(--text-h4-lh);
  }
  .facet__desc {
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
    color: var(--text-muted);
  }
  .facet--analysis .facet__icon { background: var(--cursor-analysis); color: var(--cursor-analysis-text); }
  .facet--design .facet__icon { background: var(--cursor-design); color: var(--cursor-design-text); }
  .facet--development .facet__icon { background: var(--cursor-dev); color: var(--cursor-dev-text); }
  .facet--quality .facet__icon { background: var(--cursor-qa); color: var(--cursor-qa-text); }

  /* Technologies: a compact list per group instead of chips */
  .stack__row {
    display: grid;
    grid-template-columns: 11.25rem minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: var(--border-width) solid var(--border);
  }
  .stack__row:first-child {
    padding-top: 0;
  }
  .stack__row dt {
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
    color: var(--text-faint);
  }
  .stack__row dd {
    margin: 0;
  }
  .stack__items {
    display: flex;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    line-height: var(--text-mono-lh);
    color: var(--text);
  }
  .stack__items li:not(:first-child)::before {
    content: '·';
    content: '·' / '';
    margin-inline: var(--space-2);
    color: var(--text-faint);
  }

  @media (min-width: 1024px) {
    .about__intro {
      grid-template-columns: 25rem minmax(0, 1fr);
      grid-template-areas:
        'photo title'
        'photo text';
      grid-template-rows: auto 1fr;
      column-gap: var(--space-20);
      row-gap: var(--space-6);
      align-items: start;
    }
  }
  @media (max-width: 1023.98px) {
    .facets {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 767.98px) {
    .about {
      padding-block: var(--space-20);
    }
    .about__photo {
      max-width: none;
    }
    .facets {
      grid-template-columns: 1fr;
    }
    .stack__row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
