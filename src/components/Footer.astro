---
import Icon from './Icon.astro';
import { useTranslations, type Locale } from '../i18n/utils';
import profile from '../data/profile.json';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <span class="site-footer__mark" aria-hidden="true">FM</span>
      <span class="site-footer__name">Florencia Morelli</span>
      <p class="site-footer__rights">© {year} · {t.footer.rights}</p>
    </div>

    <div class="site-footer__socials">
      <a href={profile.socials.github} target="_blank" rel="noopener" aria-label="GitHub">
        <Icon name="github-outline" size={20} />
      </a>
      <a href={profile.socials.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
        <Icon name="linkedin-outline" size={20} />
      </a>
      <a href="#top" aria-label={t.a11y.toTop}>
        <Icon name="arrow-up" size={20} />
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg);
  }
  /* The line above the footer is the container's own width, not the whole page */
  .site-footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding-block: var(--space-8);
    border-top: var(--border-width) solid var(--border);
  }
  .site-footer__brand {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-4);
  }
  .site-footer__mark {
    display: grid;
    place-items: center;
    width: 2.125rem;
    height: 2.125rem;
    border-radius: var(--radius-sm);
    background: var(--brand);
    color: var(--accent-contrast);
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    font-weight: 500;
  }
  .site-footer__name {
    font-size: var(--text-h4);
    line-height: var(--text-h4-lh);
    font-weight: 600;
    color: var(--text);
  }
  .site-footer__rights {
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
    color: var(--text-muted);
  }
  .site-footer__socials {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .site-footer__socials a {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-sm);
    color: var(--text);
    transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }
  .site-footer__socials a:hover {
    background: var(--surface-alt);
    color: var(--accent);
  }

  @media (max-width: 767.98px) {
    .site-footer__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-6);
      padding-block: var(--space-6);
    }
    .site-footer__brand {
      flex-direction: row;
    }
    .site-footer__rights {
      flex-basis: 100%;
    }
  }
</style>
