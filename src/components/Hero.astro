---
import Icon from './Icon.astro';
import { useTranslations, type Locale } from '../i18n/utils';
import type { IconName } from '../lib/types';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

type Mode = 'analysis' | 'design' | 'development' | 'quality';
const modes: { id: Mode; icon: IconName; label: string }[] = [
  { id: 'analysis', icon: 'clipboard-list', label: t.hero.modes.analysis },
  { id: 'design', icon: 'pen-tool', label: t.hero.modes.design },
  { id: 'development', icon: 'code-xml', label: t.hero.modes.development },
  { id: 'quality', icon: 'check-check', label: t.hero.modes.quality },
];
const initial: Mode = 'design';

// Annotation shown for each mode. The design mode is measured in the browser; the
// values below are what the page shows without JavaScript (desktop sizes).
const copy = {
  analysis: { tag: 'REQ-01', note: t.hero.notes.analysis },
  design: { tag: 'H1 · 900 × 216', note: 'Geist SemiBold 80/88 · Instrument Serif Italic 96/100' },
  development: { tag: '<h1>', note: 'class="hero__title"' },
  quality: { tag: t.hero.tags.quality, note: t.hero.notes.quality },
};
const modeName = (label: string) =>
  t.hero.modeName.replace('{mode}', locale === 'es' ? label.toLowerCase() : label);
const title = t.hero.title;
---

<section class="hero" data-hero data-mode={initial} data-copy={JSON.stringify(copy)}
  data-mode-names={JSON.stringify(Object.fromEntries(modes.map((m) => [m.id, modeName(m.label)])))}>
  <div class="container hero__inner">
    <div class="hero__frame">
      <div class="hero__annot" aria-hidden="true" data-annot>
        <span class="hero__tag">
          <span class="hero__tag-icon">
            {modes.map((m) => <Icon name={m.icon} size={14} class="hero__tag-svg" />)}
          </span>
          <span data-tag>{copy[initial].tag}</span>
        </span>
        <p class="hero__note" data-note aria-live="polite">{copy[initial].note}</p>
      </div>

      <div class="hero__box" data-box>
        <span class="hero__handle hero__handle--tl" aria-hidden="true"></span>
        <span class="hero__handle hero__handle--tr" aria-hidden="true"></span>
        <span class="hero__handle hero__handle--bl" aria-hidden="true"></span>
        <span class="hero__handle hero__handle--br" aria-hidden="true"></span>
        <h1 class="hero__title">
          <span class="hero__lead">{title.lead}<span class="hero__conn hero__conn--lead"> {title.connector}</span></span>
          <span class="hero__accent"><span class="hero__conn hero__conn--accent">{title.connector} </span>{title.accent}</span>
        </h1>
      </div>
    </div>

    <p class="hero__intro">{t.hero.intro}</p>

    <div class="hero__actions">
      <a class="btn btn--primary" href="#projects">
        {t.hero.viewProjects}<Icon name="arrow-right" size={18} />
      </a>
      <a class="btn btn--secondary" href="#contact">{t.hero.contact}</a>
    </div>
  </div>

  <div class="hero__cursors" aria-hidden="true">
    {modes.map((m) => (
      <div class={`hero__cursor hero__cursor--${m.id}`} data-cursor={m.id}>
        <span class="hero__cursor-float">
          <svg class="hero__cursor-arrow" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3.03 3.52a.5.5 0 0 1 .49-.49l12 4.88a.5.5 0 0 1-.05.7l-4.59 1.19a1.5 1.5 0 0 0-1.08 1.08l-1.18 4.6a.5.5 0 0 1-.7.05z" />
          </svg>
          <svg class="hero__cursor-hand" width="18" height="18" viewBox="2 1 21 21" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 14a8 8 0 0 1-8 8" />
            <path d="M18 11v-1a2 2 0 0 0-2-2a2 2 0 0 0-2 2" />
            <path d="M14 10V9a2 2 0 0 0-2-2a2 2 0 0 0-2 2v1" />
            <path d="M10 9.5V4a2 2 0 0 0-2-2a2 2 0 0 0-2 2v10" />
            <path d="M18 11a2 2 0 1 1 4 0v3a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15" />
          </svg>
          <span class="hero__cursor-label">{m.label}</span>
        </span>
      </div>
    ))}
  </div>

  <div class="hero__bar" role="radiogroup" aria-label={t.hero.modes.label} data-bar>
    {modes.map((m) => (
      <button
        type="button"
        role="radio"
        class="hero__mode"
        data-mode={m.id}
        aria-checked={m.id === initial ? 'true' : 'false'}
        tabindex={m.id === initial ? 0 : -1}
        aria-label={m.label}
        title={m.label}
      >
        <Icon name={m.icon} size={20} />
        <span class="hero__mode-name" aria-hidden="true">{m.label}</span>
      </button>
    ))}
    <span class="hero__bar-sep" aria-hidden="true"></span>
    <span class="hero__bar-label" aria-hidden="true" data-mode-label>{modeName(modes.find((m) => m.id === initial)!.label)}</span>
  </div>
</section>

<style>
  .hero {
    /* Measures from the hero interaction sheet (hero.md), 1440 × 900 */
    --hero-h: 56.25rem;
    --hero-box-w: 56.25rem;
    --hero-box-h: 13.5rem;
    --hero-box-top: 6.875rem;
    --hero-bar-bottom: 3.5rem;

    position: relative;
    padding-block: calc(var(--header-h) + var(--space-8)) var(--space-16);
    background-image: radial-gradient(circle, var(--canvas-dot) 1px, transparent 1.5px);
    background-size: var(--space-6) var(--space-6);
    overflow: hidden;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  /* Selection box with its annotation */
  .hero__frame {
    position: relative;
    width: min(var(--hero-box-w), 100%);
    margin-inline: auto;
  }
  .hero__annot {
    display: flex;
    align-items: stretch;
    text-align: left;
    margin-bottom: calc(var(--border-width) * -1);
  }
  .hero__tag {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-2);
    background: var(--accent);
    color: var(--accent-contrast);
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    line-height: var(--text-mono-lh);
    font-weight: 500;
  }
  .hero__tag-icon {
    display: inline-grid;
  }
  .hero__tag-icon :global(.hero__tag-svg) {
    display: none;
    grid-area: 1 / 1;
  }
  .hero[data-mode='analysis'] .hero__tag-icon :global(.hero__tag-svg:nth-child(1)),
  .hero[data-mode='design'] .hero__tag-icon :global(.hero__tag-svg:nth-child(2)),
  .hero[data-mode='development'] .hero__tag-icon :global(.hero__tag-svg:nth-child(3)),
  .hero[data-mode='quality'] .hero__tag-icon :global(.hero__tag-svg:nth-child(4)) {
    display: block;
  }
  .hero__note {
    display: flex;
    align-items: center;
    padding: var(--space-1) var(--space-3);
    background: var(--surface);
    color: var(--text);
    border-radius: 0 var(--radius-xs) var(--radius-xs) 0;
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
  }
  .hero[data-mode='design'] .hero__note,
  .hero[data-mode='development'] .hero__note {
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    line-height: var(--text-mono-lh);
  }

  .hero__box {
    position: relative;
    display: grid;
    place-items: center;
    min-height: var(--hero-box-h);
    padding: var(--space-3) var(--space-4);
    border: var(--border-width) solid var(--accent);
  }
  .hero__handle {
    position: absolute;
    width: var(--space-2);
    height: var(--space-2);
    background: var(--surface);
    border: var(--border-width) solid var(--accent);
    opacity: 0;
    transform: scale(0.6);
    transition: opacity var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  }
  .hero[data-mode='design'] .hero__handle {
    opacity: 1;
    transform: none;
  }
  .hero__handle--tl { top: calc(var(--space-1) * -1 - var(--border-width)); left: calc(var(--space-1) * -1 - var(--border-width)); }
  .hero__handle--tr { top: calc(var(--space-1) * -1 - var(--border-width)); right: calc(var(--space-1) * -1 - var(--border-width)); }
  .hero__handle--bl { bottom: calc(var(--space-1) * -1 - var(--border-width)); left: calc(var(--space-1) * -1 - var(--border-width)); }
  .hero__handle--br { bottom: calc(var(--space-1) * -1 - var(--border-width)); right: calc(var(--space-1) * -1 - var(--border-width)); }

  /* Headline: on small screens the connector moves to the accent line. */
  .hero__title {
    font-size: var(--text-display);
    line-height: var(--text-display-lh);
    letter-spacing: var(--text-display-ls);
  }
  .hero__lead,
  .hero__accent {
    display: block;
  }
  .hero__accent {
    font-family: var(--font-accent);
    font-style: italic;
    font-weight: 400;
    font-size: var(--text-display-accent);
    line-height: var(--text-display-accent-lh);
    letter-spacing: 0;
    color: var(--accent);
  }
  .hero__conn--accent {
    display: none;
  }

  .hero__intro {
    max-width: 40rem;
    margin: var(--space-10) auto 0;
    font-size: var(--text-lead);
    line-height: var(--text-lead-lh);
    color: var(--text-muted);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  /* One cursor per mode. The idle ones use the solid idle colours (they pass AA); the active one
     uses the full colour. Clicking one switches to its mode. They duplicate the mode bar for the
     mouse, so they stay out of the accessibility tree. */
  .hero__cursors {
    display: none;
  }
  .hero__cursor {
    position: absolute;
    cursor: pointer;
    pointer-events: auto;
    will-change: transform;
  }
  .hero__cursor-float {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: calc(var(--space-1) / 2);
    transition: scale var(--dur-fast) var(--ease);
  }
  .hero__cursor:hover .hero__cursor-float {
    scale: 1.08;
  }
  /* The arrow turns into a pointing hand under the mouse, as a hint that it can be clicked. */
  .hero__cursor-hand {
    display: none;
  }
  .hero__cursor:hover .hero__cursor-arrow {
    display: none;
  }
  .hero__cursor:hover .hero__cursor-hand {
    display: block;
  }
  .hero__cursor:active .hero__cursor-float {
    scale: 0.94;
  }
  /* Each cursor drifts on its own rhythm while it waits. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__cursor-float {
      animation: hero-drift var(--drift-time) ease-in-out var(--drift-delay) infinite alternate;
    }
  }
  @keyframes hero-drift {
    to {
      translate: var(--drift-x) var(--drift-y);
    }
  }
  .hero__cursor-label {
    padding: 0 var(--space-2);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    line-height: var(--text-mono-sm-lh);
    font-weight: 500;
    white-space: nowrap;
  }
  .hero__cursor--analysis { left: 13.89%; top: 27.78%; --drift-x: 0.5rem; --drift-y: -0.625rem; --drift-time: 5.2s; --drift-delay: 0s; }
  .hero__cursor--design { left: 79.86%; top: 21.11%; --drift-x: -0.625rem; --drift-y: 0.5rem; --drift-time: 6.4s; --drift-delay: -2s; }
  .hero__cursor--development { left: 77.08%; top: 56.67%; --drift-x: -0.5rem; --drift-y: -0.5rem; --drift-time: 5.8s; --drift-delay: -4s; }
  .hero__cursor--quality { left: 15.97%; top: 60%; --drift-x: 0.625rem; --drift-y: 0.625rem; --drift-time: 7s; --drift-delay: -1s; }
  .hero__cursor--analysis { --c: var(--cursor-analysis-idle); --c-text: var(--cursor-analysis-idle-text); }
  .hero__cursor--design { --c: var(--cursor-design-idle); --c-text: var(--cursor-design-idle-text); }
  .hero__cursor--development { --c: var(--cursor-dev-idle); --c-text: var(--cursor-dev-idle-text); }
  .hero__cursor--quality { --c: var(--cursor-qa-idle); --c-text: var(--cursor-qa-idle-text); }
  .hero[data-mode='analysis'] .hero__cursor--analysis { --c: var(--cursor-analysis); --c-text: var(--cursor-analysis-text); }
  .hero[data-mode='design'] .hero__cursor--design { --c: var(--cursor-design); --c-text: var(--cursor-design-text); }
  .hero[data-mode='development'] .hero__cursor--development { --c: var(--cursor-dev); --c-text: var(--cursor-dev-text); }
  .hero[data-mode='quality'] .hero__cursor--quality { --c: var(--cursor-qa); --c-text: var(--cursor-qa-text); }
  .hero__cursor {
    color: var(--c);
  }
  .hero__cursor-label {
    background: var(--c);
    color: var(--c-text);
  }

  /* Mode bar: needs JS, so it stays hidden without it (the headline stays in Design mode). */
  .hero__bar {
    display: none;
    position: relative;
    z-index: 1;
    align-items: center;
    gap: var(--space-1);
    margin: var(--space-8) auto 0;
    padding: 0.375rem;
    width: fit-content;
    background: var(--surface);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-2);
  }
  :global(.js) .hero__bar {
    display: flex;
  }
  .hero__mode {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--text-faint);
    transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }
  .hero__mode:hover {
    background: var(--surface-alt);
    color: var(--text);
  }
  .hero__mode[aria-checked='true'] {
    background: var(--accent-soft);
    color: var(--accent);
  }
  .hero__mode-name {
    display: none;
  }
  .hero__bar-sep {
    width: var(--border-width);
    height: var(--space-6);
    margin-inline: var(--space-2) 0;
    background: var(--border);
  }
  .hero__bar-label {
    padding-inline: var(--space-3) var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    line-height: var(--text-mono-lh);
    color: var(--text-faint);
    white-space: nowrap;
  }

  /* Below 1024px the layout stacks: connector on the accent line. */
  @media (max-width: 1023.98px) {
    .hero__conn--lead {
      display: none;
    }
    .hero__conn--accent {
      display: inline;
    }
  }

  /* Tablet (Hero · 820 in Figma): headline in two lines, sizes of the hero only (not tokens). */
  @media (min-width: 768px) and (max-width: 1023.98px) {
    .hero {
      padding-top: calc(var(--header-h) + var(--space-16));
    }
    .hero__box {
      min-height: 10.5rem;
      padding-block: var(--space-2);
    }
    .hero__title {
      font-size: 4rem;
      line-height: 4.5rem;
    }
    .hero__accent {
      font-size: 4.75rem;
      line-height: 5rem;
    }
    .hero__actions {
      margin-top: var(--space-10);
    }
  }

  @media (min-width: 1024px) {
    .hero {
      padding-top: calc(var(--header-h) + var(--hero-box-top));
    }
    .hero__annot {
      position: absolute;
      bottom: 100%;
      left: calc(var(--border-width) * -1);
    }
  }
  /* The cursors need the side margins: below 1280px they would cover the headline and the intro. */
  @media (min-width: 1280px) {
    .hero__cursors {
      display: block;
      position: absolute;
      inset: 0;
      z-index: 2;
      pointer-events: none;
    }
  }

  /* Short screens: less air above the box so the bar still fits in the first screen. */
  @media (min-width: 1024px) and (max-height: 46.99rem) {
    .hero {
      padding-top: calc(var(--header-h) + var(--space-12));
    }
  }

  /* With room to spare, the hero fills the first screen and the bar sits at its bottom.
     On short screens the bar stays under the buttons so it is never pushed below the fold. */
  @media (min-width: 1024px) and (min-height: 47rem) {
    .hero {
      min-height: min(var(--hero-h), 100svh);
    }
    :global(.js) .hero__bar {
      position: absolute;
      left: 50%;
      bottom: var(--hero-bar-bottom);
      margin: 0;
      transform: translateX(-50%);
    }
  }

  @media (max-width: 767.98px) {
    .hero__inner {
      text-align: left;
    }
    .hero__annot {
      margin-bottom: var(--space-6);
    }
    .hero__box {
      min-height: 13.125rem;
      place-items: center start;
    }
    .hero__intro {
      margin-top: var(--space-6);
    }
    .hero__actions {
      justify-content: flex-start;
      margin-top: var(--space-6);
    }
    .hero__bar {
      width: auto;
      margin-inline: var(--container-pad);
    }
    .hero__mode {
      flex: 1;
      flex-direction: column;
      gap: var(--space-1);
      width: auto;
      height: 3.25rem;
    }
    .hero__mode-name {
      display: block;
      font-family: var(--font-mono);
      font-size: var(--text-mono-sm);
      line-height: var(--text-mono-sm-lh);
    }
    .hero__bar-sep,
    .hero__bar-label {
      display: none;
    }
  }
</style>

<script>
  type Mode = 'analysis' | 'design' | 'development' | 'quality';
  const order: Mode[] = ['analysis', 'design', 'development', 'quality'];

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const copy = JSON.parse(hero.dataset.copy ?? '{}') as Record<Mode, { tag: string; note: string }>;
    const names = JSON.parse(hero.dataset.modeNames ?? '{}') as Record<Mode, string>;
    const bar = hero.querySelector<HTMLElement>('[data-bar]')!;
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>('[data-mode]')];
    const tag = hero.querySelector<HTMLElement>('[data-tag]')!;
    const note = hero.querySelector<HTMLElement>('[data-note]')!;
    const label = hero.querySelector<HTMLElement>('[data-mode-label]')!;
    const box = hero.querySelector<HTMLElement>('[data-box]')!;
    const lead = hero.querySelector<HTMLElement>('.hero__lead')!;
    const accent = hero.querySelector<HTMLElement>('.hero__accent')!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    // The design mode shows the real measures of the headline box and its type.
    const px = (el: HTMLElement, prop: 'fontSize' | 'lineHeight') => Math.round(parseFloat(getComputedStyle(el)[prop]));
    const measured = () => ({
      tag: `H1 · ${Math.round(box.offsetWidth)} × ${Math.round(box.offsetHeight)}`,
      note: `Geist SemiBold ${px(lead, 'fontSize')}/${px(lead, 'lineHeight')} · Instrument Serif Italic ${px(accent, 'fontSize')}/${px(accent, 'lineHeight')}`,
    });
    const content = (mode: Mode) => (mode === 'design' ? measured() : copy[mode]);

    let current = (hero.dataset.mode as Mode) ?? 'design';

    function render(mode: Mode, animate: boolean) {
      const { tag: tagText, note: noteText } = content(mode);
      if (tag.textContent !== tagText) tag.textContent = tagText;
      if (note.textContent !== noteText) note.textContent = noteText;
      label.textContent = names[mode];
      if (animate && !reduced.matches) {
        tag.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 140, easing: 'ease-out' });
      }
    }

    function select(mode: Mode, focus = false) {
      current = mode;
      hero!.dataset.mode = mode;
      buttons.forEach((b) => {
        const on = b.dataset.mode === mode;
        b.setAttribute('aria-checked', String(on));
        b.tabIndex = on ? 0 : -1;
        if (on && focus) b.focus();
      });
      render(mode, true);
    }

    bar.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-mode]');
      if (btn) select(btn.dataset.mode as Mode);
    });
    bar.addEventListener('keydown', (e) => {
      const i = order.indexOf(current);
      const next: Record<string, number> = {
        ArrowRight: (i + 1) % order.length,
        ArrowDown: (i + 1) % order.length,
        ArrowLeft: (i - 1 + order.length) % order.length,
        ArrowUp: (i - 1 + order.length) % order.length,
        Home: 0,
        End: order.length - 1,
      };
      if (e.key in next) {
        e.preventDefault();
        select(order[next[e.key]], true);
      }
    });

    // The annotation is a live region only once the bar is usable.
    hero.querySelector('[data-annot]')?.removeAttribute('aria-hidden');
    render(current, false);
    new ResizeObserver(() => current === 'design' && render('design', false)).observe(box);

    // Each cursor leans toward the mouse by its own amount and catches up at its own pace.
    // Not with reduced motion, touch or small screens. Clicking one switches to its mode.
    const cursors = [...hero.querySelectorAll<HTMLElement>('[data-cursor]')].map((el, i) => ({
      el,
      x: 0,
      y: 0,
      tx: 0,
      ty: 0,
      reach: [26, 34, 22, 30][i % 4],
      ease: [0.07, 0.11, 0.085, 0.13][i % 4],
    }));
    const wide = window.matchMedia('(min-width: 1280px) and (pointer: fine)');
    let frame = 0;

    const step = () => {
      let moving = false;
      for (const c of cursors) {
        c.x += (c.tx - c.x) * c.ease;
        c.y += (c.ty - c.y) * c.ease;
        if (Math.abs(c.tx - c.x) > 0.05 || Math.abs(c.ty - c.y) > 0.05) moving = true;
        c.el.style.transform = `translate3d(${c.x.toFixed(2)}px, ${c.y.toFixed(2)}px, 0)`;
      }
      frame = moving ? requestAnimationFrame(step) : 0;
    };
    const run = () => {
      if (!frame) frame = requestAnimationFrame(step);
    };
    const settle = () => {
      cursors.forEach((c) => ((c.tx = 0), (c.ty = 0)));
      if (reduced.matches || !wide.matches) {
        cursors.forEach((c) => ((c.x = 0), (c.y = 0), c.el.style.removeProperty('transform')));
      } else run();
    };

    window.addEventListener('pointermove', (e) => {
      if (reduced.matches || !wide.matches) return;
      for (const c of cursors) {
        const r = c.el.getBoundingClientRect();
        const dx = e.clientX - (r.left - c.x + r.width / 2);
        const dy = e.clientY - (r.top - c.y + r.height / 2);
        const dist = Math.hypot(dx, dy) || 1;
        const pull = c.reach * Math.min(1, dist / 360);
        c.tx = (dx / dist) * pull;
        c.ty = (dy / dist) * pull;
      }
      run();
    });
    hero.addEventListener('pointerleave', settle);
    reduced.addEventListener('change', settle);
    wide.addEventListener('change', settle);

    cursors.forEach((c) => c.el.addEventListener('click', () => select(c.el.dataset.cursor as Mode)));
  }
</script>
