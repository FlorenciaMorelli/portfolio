---
// A cursor of the lens a section belongs to (Análisis, Diseño, Desarrollo or Calidad), as if
// someone were working there. It enters with the section, drifts and leans toward the mouse like
// the hero's (src/lib/cursors.ts). Decorative (aria-hidden), only from 1280px, so it never
// covers text. The page's closing footer brings the four together.
import { useTranslations, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
  lens: 'analysis' | 'design' | 'development' | 'quality';
  /** Horizontal offset from the left edge of the content, above the section's title. */
  left?: string;
}
const { locale, lens, left = '0rem' } = Astro.props;
const t = useTranslations(locale);
---

<span class={`section-cursor section-cursor--${lens} reveal`} style={`--left: ${left}`} aria-hidden="true" data-section-cursor>
  <span class="section-cursor__float">
    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3.03 3.52a.5.5 0 0 1 .49-.49l12 4.88a.5.5 0 0 1-.05.7l-4.59 1.19a1.5 1.5 0 0 0-1.08 1.08l-1.18 4.6a.5.5 0 0 1-.7.05z" />
    </svg>
    <span class="section-cursor__label">{t.hero.modes[lens]}</span>
  </span>
</span>

<style>
  .section-cursor {
    position: absolute;
    top: calc(var(--space-16) * -1);
    left: var(--left);
    z-index: 2;
    display: none;
    pointer-events: none;
    will-change: transform;
  }
  @media (min-width: 1280px) {
    .section-cursor {
      display: block;
    }
  }
  .section-cursor__float {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: calc(var(--space-1) / 2);
    color: var(--c);
  }
  @media (prefers-reduced-motion: no-preference) {
    .section-cursor__float {
      animation: section-drift var(--drift-time) ease-in-out var(--drift-delay) infinite alternate;
    }
  }
  @keyframes section-drift {
    from {
      translate: calc(var(--drift-x) * -1) calc(var(--drift-y) * -1);
    }
    to {
      translate: var(--drift-x) var(--drift-y);
    }
  }
  .section-cursor__label {
    padding: 0 var(--space-2);
    border-radius: var(--radius-pill);
    background: var(--c);
    color: var(--c-text);
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    line-height: var(--text-mono-sm-lh);
    font-weight: 500;
    white-space: nowrap;
  }
  .section-cursor--analysis { --c: var(--cursor-analysis); --c-text: var(--cursor-analysis-text); --drift-x: 3px; --drift-y: -3px; --drift-time: 3s; --drift-delay: 0s; }
  .section-cursor--design { --c: var(--cursor-design); --c-text: var(--cursor-design-text); --drift-x: -3px; --drift-y: 3px; --drift-time: 4s; --drift-delay: -2s; }
  .section-cursor--development { --c: var(--cursor-dev); --c-text: var(--cursor-dev-text); --drift-x: -3px; --drift-y: -3px; --drift-time: 4.5s; --drift-delay: -3s; }
  .section-cursor--quality { --c: var(--cursor-qa); --c-text: var(--cursor-qa-text); --drift-x: 3px; --drift-y: 3px; --drift-time: 5.5s; --drift-delay: -1s; }
</style>

<script>
  import { followPointer } from '../lib/cursors';

  const cursors = [...document.querySelectorAll<HTMLElement>('[data-section-cursor]')];
  if (cursors.length) followPointer(document.documentElement, cursors);
</script>
