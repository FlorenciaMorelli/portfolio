---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { useTranslations, type Locale } from '../i18n/utils';
import { caseStudyPath } from '../lib/case-studies';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section id="experience" class="section experience">
  <div class="container">
    <SectionHeading title={t.experience.title} />
    <ol class="jobs">
      {t.experience.jobs.map((job) => (
        <li class:list={['job', 'reveal', !job.points && 'job--compact']}>
          <p class="job__when">{job.period}</p>

          <div class="job__body">
            <h3 class="job__role">{job.role}</h3>

            {job.facets && (
              <ul class="job__facets">
                {job.facets.map((facet) => <li class={`facet-chip facet-chip--${facet}`}>{t.hero.modes[facet]}</li>)}
              </ul>
            )}

            <p class="job__org">
              {job.orgUrl ? (
                <a href={job.orgUrl} target="_blank" rel="noopener">{job.org}</a>
              ) : (
                job.org
              )}
            </p>

            {job.points && (
              <ul class="job__points">
                {job.points.map((point) => <li>{point}</li>)}
              </ul>
            )}

            {job.tech && (
              <ul class="job__tech">
                {job.tech.split(', ').map((tech) => <li>{tech}</li>)}
              </ul>
            )}

            {job.caseStudy && (
              <a class="job__more" href={caseStudyPath(locale, job.caseStudy.slug)}>
                {job.caseStudy.label}<Icon name="arrow-right" size={18} />
              </a>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .experience {
    padding-block: var(--space-30);
  }
  .jobs {
    margin-top: var(--space-5);
    padding: 0;
    list-style: none;
  }

  /* Date on the left, the job on the right */
  .job {
    display: grid;
    grid-template-columns: 12.5rem minmax(0, 1fr);
    column-gap: var(--space-10);
    padding-block: calc(var(--space-6) + var(--space-1));
    border-top: var(--border-width) solid var(--border);
  }
  .job:first-child {
    border-top: 0;
  }
  .job--compact {
    padding-block: var(--space-5);
  }
  .job__when {
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    line-height: var(--text-mono-lh);
    color: var(--text-faint);
  }
  .job__role {
    font-size: var(--text-h4);
    line-height: var(--text-h4-lh);
  }

  /* Facet chips, colored like their hero cursor */
  .job__facets {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  .facet-chip {
    padding: 0.1875rem var(--space-2);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    line-height: var(--text-mono-sm-lh);
    font-weight: 500;
  }
  .facet-chip--analysis { background: var(--cursor-analysis); color: var(--cursor-analysis-text); }
  .facet-chip--design { background: var(--cursor-design); color: var(--cursor-design-text); }
  .facet-chip--development { background: var(--cursor-dev); color: var(--cursor-dev-text); }
  .facet-chip--quality { background: var(--cursor-qa); color: var(--cursor-qa-text); }

  .job__org {
    margin-top: var(--space-3);
    color: var(--text-muted);
  }
  .job--compact .job__org {
    margin-top: 0;
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
  }
  .job__org a {
    text-decoration-line: underline;
    text-underline-offset: 0.25em;
  }

  .job__points {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 45rem;
    margin-top: var(--space-4);
  }
  .job__points li {
    position: relative;
    padding-left: var(--space-5);
    color: var(--text-muted);
  }
  .job__points li::before {
    content: '';
    position: absolute;
    left: var(--space-1);
    top: 0.6em;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: var(--radius-pill);
    background: var(--accent);
  }

  .job__tech {
    display: flex;
    flex-wrap: wrap;
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    line-height: var(--text-mono-lh);
    color: var(--accent);
  }
  /* The dot goes after each item, so a wrapped line never starts with it. */
  .job__tech li:not(:last-child)::after {
    content: '·';
    content: '·' / '';
    margin-inline: var(--space-2);
  }

  .job__more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    font-size: var(--text-button);
    line-height: var(--text-button-lh);
    font-weight: 600;
  }
  .job__more :global(svg) {
    transition: transform var(--dur-fast) var(--ease);
  }
  @media (prefers-reduced-motion: no-preference) {
    .job__more:hover :global(svg) {
      transform: translateX(var(--space-1));
    }
  }

  @media (max-width: 767.98px) {
    .experience {
      padding-block: var(--space-20);
    }
    .job {
      grid-template-columns: 1fr;
      row-gap: var(--space-3);
      padding-block: var(--space-6);
    }
    .job--compact {
      padding-block: var(--space-4);
      row-gap: var(--space-1);
    }
  }
</style>
