---
import Icon from './Icon.astro';
import { useTranslations, type Locale } from '../i18n/utils';
import profile from '../data/profile.json';
import type { IconName } from '../lib/types';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const action = `https://formsubmit.co/${profile.email}`;
const redirect = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

// Direct links: the address shown is the URL without its protocol.
const bare = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const links: { icon: IconName; label: string; text: string; href: string; external?: boolean }[] = [
  { icon: 'mail', label: t.contact.email, text: profile.email, href: `mailto:${profile.email}` },
  { icon: 'linkedin-outline', label: 'LinkedIn', text: bare(profile.socials.linkedin), href: profile.socials.linkedin, external: true },
  { icon: 'github-outline', label: 'GitHub', text: bare(profile.socials.github), href: profile.socials.github, external: true },
];
---

<section id="contact" class="section contact">
  <div class="container contact__inner">
    <div class="contact__intro">
      <h2 class="contact__title">{t.contact.title}</h2>
      <p class="contact__lead">{t.contact.intro}</p>

      <ul class="contact__links">
        {links.map((link) => (
          <li>
            <span class="contact__tile" aria-hidden="true"><Icon name={link.icon} size={20} /></span>
            <div>
              <span class="contact__label">{link.label}</span>
              <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener' : undefined}>{link.text}</a>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <form class="contact__form reveal" action={action} method="POST">
      <input type="hidden" name="_captcha" value="false" />
      <input type="hidden" name="_next" value={redirect} />
      <input type="hidden" name="_subject" value="Portfolio - nuevo mensaje" />
      <input
        type="text"
        name="_honey"
        class="visually-hidden"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
      />

      <label class="field">
        <span>{t.contact.name}</span>
        <input type="text" name="name" required autocomplete="name" />
      </label>
      <label class="field">
        <span>{t.contact.email}</span>
        <input type="email" name="email" required autocomplete="email" />
      </label>
      <label class="field">
        <span>{t.contact.message}</span>
        <textarea name="message" rows="5" required></textarea>
      </label>

      <button type="submit" class="btn btn--primary">
        {t.contact.send}<Icon name="arrow-right" size={18} />
      </button>
    </form>
  </div>
</section>

<style>
  .contact {
    padding-block: var(--space-30);
  }
  /* Text and direct links on the left, the form in a card on the right */
  .contact__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 40rem);
    column-gap: var(--space-10);
    align-items: start;
  }
  .contact__title {
    font-family: var(--font-accent);
    font-style: italic;
    font-weight: 400;
    font-size: var(--text-h2-accent);
    line-height: var(--text-h2-accent-lh);
    letter-spacing: 0;
    color: var(--accent);
  }
  .contact__lead {
    max-width: 28rem;
    margin-top: var(--space-4);
    font-size: var(--text-lead);
    line-height: var(--text-lead-lh);
    color: var(--text-muted);
  }
  .contact__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    margin-top: var(--space-8);
  }
  .contact__links li {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .contact__tile {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
    color: var(--accent);
  }
  .contact__label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    line-height: var(--text-mono-lh);
    color: var(--text-faint);
  }
  .contact__links a {
    text-decoration-line: underline;
    text-underline-offset: 0.25em;
    overflow-wrap: anywhere;
  }

  .contact__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--space-8);
    background: var(--surface);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-1);
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .field span {
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
    font-weight: 500;
    color: var(--text);
  }
  .field input,
  .field textarea {
    width: 100%;
    padding: 0 var(--space-4);
    background: var(--surface);
    border: var(--border-width) solid var(--border-strong);
    border-radius: var(--radius-md);
    color: var(--text);
    font: inherit;
    transition: border-color var(--dur-fast) var(--ease);
  }
  .field input {
    height: 3rem;
  }
  .field textarea {
    min-height: 8.75rem;
    padding-block: var(--space-3);
    resize: vertical;
  }
  .field input:disabled,
  .field textarea:disabled {
    background: var(--surface-alt);
    border-color: var(--border);
    color: var(--text-disabled);
    cursor: not-allowed;
  }
  .field:has(:disabled) span {
    color: var(--text-disabled);
  }
  .field input:focus-visible,
  .field textarea:focus-visible {
    border-color: var(--accent);
  }
  .contact__form .btn {
    align-self: flex-start;
  }

  @media (max-width: 1023.98px) {
    .contact__inner {
      grid-template-columns: 1fr;
      row-gap: var(--space-10);
    }
  }
  @media (max-width: 767.98px) {
    .contact {
      padding-block: var(--space-20);
    }
    .contact__form {
      padding: var(--space-5);
    }
  }
</style>
